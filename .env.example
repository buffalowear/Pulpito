# Copie este arquivo para ".env.local" e preencha.

# --- Supabase (Project Settings → API) ---
# Endereço do projeto e chave pública "anon". As duas podem aparecer no navegador:
# quem protege os dados são as regras de acesso do banco (supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica-anon

# Subpasta onde o site será publicado (ex.: /pulpito no GitHub Pages).
# Deixe vazio se o site ficar na raiz do endereço.
NEXT_PUBLIC_BASE_PATH=
